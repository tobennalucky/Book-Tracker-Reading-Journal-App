<%- include('partials/header.ejs') %>
<div id="create-edit min-vh-100" class="my-5">
<div class="px-4 pt-5 my-5 text-center border-bottom">
  <h1 class="display-4 fw-bold title">Add a book</h1>
  <div class="col-lg-6 mx-auto d-flex flex-column align-items-center">
    <p class="lead mb-4">Tell us about the book.</p>
    <form action="/add" method="POST" class="form" >
        <div class="form-floating mb-3 pt-5">
            <input type="text" class="form-control text-black" id="title" name="title" placeholder="Title" required>
            <label for="title">Book Title</label>
        </div>
        <div class="form-floating mb-3 pt-5">
            <input type="text" class="form-control text-black" id="author" name="author" placeholder="Author" required>
            <label for="author">Book Author</label>
        </div>
        <div class="form-floating mb-3 pt-5">
            <input type="text" class="form-control text-black" id="isbn" name="isbn" placeholder="ISBN" required>
            <label for="isbn">Book ISBN</label>
        </div>
        <div class="form-floating mb-3 pt-5">
            <input type="number" class="form-control text-black" id="rating" name="rating" placeholder="Rating" min="1" max="10" required>
            <label for="rating">Rate the Book (1-10)</label>
        </div>
        <div class="form-floating mb-3 pt-5">
            <input type="date" class="form-control text-black" id="date_read" name="date_read" placeholder="Date Read" required>
            <label for="date_read">When did you read it?</label>
        </div>
         <div class="form-floating mb-3 mt-3 pt-5">
            <textarea class="form-control text-black" id="review" name="review" placeholder="What did you think of the book?" style="height: 200px;" required></textarea>
            <label for="desc">Book Review</label>
        </div>
        <input class="btn btn-primary btn-lg mt-3 mb-5" type="submit" value="Add Book">
    </form>
  </div>
</div>
</div>
      
 
<%- include('partials/footer.ejs') %>